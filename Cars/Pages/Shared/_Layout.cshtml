<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171615" />
    <title>@ViewData["Title"] · AUTODOK</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-page="/Index" aria-label="AUTODOK home"><span class="brand-mark">AD</span><span>AUTO<strong>DOK</strong></span></a>
            <nav class="main-nav" aria-label="Main navigation">
                <a asp-page="/Index">Explore cars</a>
                <a asp-page="/Bookings/MyRentals">My rentals</a>
                <a asp-page="/Admin/Index">Admin</a>
            </nav>
        </div>
    </header>
    <main id="main-content">@RenderBody()</main>
    <footer class="site-footer"><div class="shell footer-inner"><span>AUTODOK</span><span>Classroom demo · Data resets when the app closes</span></div></footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
