@page "{id:int}"
@model AUTODOK.Pages.Admin.ReceiptModel
@{ ViewData["Title"] = "Receipt"; }
<div class="admin-page-heading"><div><h1>Payment receipt</h1><p>Print this page or save it as a PDF from your browser.</p></div><button class="button button-orange print-button" type="button" onclick="window.print()">Print / save PDF</button></div>
<article class="admin-panel receipt-card"><div class="receipt-title"><img class="brand-logo receipt-logo" src="~/images/autodok-logo.png" asp-append-version="true" alt="AUTODOK" /><span>TXN-@Model.Payment.PaymentID.ToString("D5")</span></div><h2>Rental payment record</h2>
    <div class="detail-line"><span>Customer</span><strong>@Model.Customer.FullName</strong></div><div class="detail-line"><span>Vehicle</span><strong>@Model.Car.DisplayName</strong></div><div class="detail-line"><span>Rental dates</span><strong>@Model.Rental.PickupDate.ToString("MMM d") – @Model.Rental.PlannedReturnDate.ToString("MMM d, yyyy")</strong></div><div class="detail-line"><span>Payment method</span><strong>@Model.Payment.Method</strong></div><div class="detail-line"><span>Status</span><strong>@Model.Payment.Status</strong></div><div class="detail-line"><span>Rental fee</span><strong>₱@Model.Rental.BaseAmount.ToString("N0")</strong></div><div class="detail-line"><span>Insurance</span><strong>₱@Model.Rental.InsuranceFee.ToString("N0")</strong></div><div class="detail-line detail-total"><span>Total</span><strong>₱@Model.Payment.Amount.ToString("N0")</strong></div><p class="muted">Classroom demo record. No payment processor is connected.</p>
</article>
