@page
@model AUTODOK.Pages.Admin.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Admin login";
}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>Admin login · AUTODOK</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /></head>
<body class="login-screen"><main class="split-login">
    <section class="login-hero"><a class="brand login-brand" asp-page="/Index"><img class="brand-logo" src="~/images/autodok-logo.png" asp-append-version="true" alt="AUTODOK" /><small>Car Rental Admin</small></a><div class="login-hero-copy"><h1>Manage Rentals<br />with Ease</h1><p>Track bookings, manage vehicles, and handle payments—all in one place.</p><div class="login-feature-row"><div><strong>01</strong><span>Manage bookings</span></div><div><strong>02</strong><span>Track vehicles</span></div><div><strong>03</strong><span>Record payments</span></div></div></div></section>
    <section class="login-right"><div class="login-form-card"><img class="brand-logo login-card-logo" src="~/images/autodok-logo.png" asp-append-version="true" alt="AUTODOK" /><h2>Welcome Back</h2><p>Log in to your admin account</p><form method="post" class="stack-form"><div asp-validation-summary="ModelOnly" class="validation" role="alert"></div><label>Username<input asp-for="Username" autocomplete="username" placeholder="Enter admin username" required /></label><label>Password<span class="password-wrap"><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Enter password" required /><button type="button" data-toggle-password aria-label="Show password">Show</button></span></label><label class="remember-row"><input asp-for="RememberMe" /> Remember me</label><button class="button button-orange button-wide" type="submit">Log In →</button></form><div class="login-foot">Classroom demo · Admin access only</div></div></section>
</main><script src="~/js/site.js" asp-append-version="true"></script></body></html>
