@page
@model AUTODOK.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="admin-page-heading dashboard-heading"><div><h1>Good to see you, Admin</h1><p>Here is what is happening with your car rental business today.</p></div><time datetime="@DateTime.Today.ToString("yyyy-MM-dd")">@DateTime.Today.ToString("MMM d, yyyy")</time></div>
<div class="stats-grid">
    <article class="stat-tile"><span>TOTAL VEHICLES</span><strong>@Model.TotalCars</strong><small>@Model.AvailableCars available · @Model.ActiveRentals rented</small></article>
    <article class="stat-tile"><span>TOTAL BOOKINGS</span><strong>@Model.TotalBookings</strong><small>All rental transactions</small></article>
    <article class="stat-tile"><span>CUSTOMERS</span><strong>@Model.Customers</strong><small>Registered in this session</small></article>
    <article class="stat-tile"><span>TOTAL REVENUE</span><strong>₱@Model.Revenue.ToString("N0")</strong><small>Completed rentals</small></article>
</div>
<div class="dashboard-analytics">
    <section class="admin-panel chart-panel"><div class="panel-heading"><h2>Bookings overview</h2><span>Last 7 days</span></div><svg class="booking-chart" viewBox="0 0 600 180" role="img" aria-label="Bookings in the last seven days"><path d="M40 40H558 M40 95H558 M40 150H558" class="chart-grid" /><polyline points="@Model.ChartPoints" class="chart-line" /></svg><div class="chart-dates">@foreach (string date in Model.ChartDates) { <span>@date</span> }</div></section>
    <section class="admin-panel vehicle-types-panel"><h2>Vehicle types</h2><div class="type-content"><div class="donut-chart" style="@Model.DonutStyle"><div><strong>@Model.TotalCars</strong><span>Total vehicles</span></div></div><div class="type-legend">@foreach (var type in Model.VehicleTypes) { <div><i style="background:@type.Color"></i><span>@type.Name</span><strong>@type.Count</strong><small>@type.Percent.ToString("N0")%</small></div> }</div></div></section>
</div>
<div class="dashboard-bottom">
    <section class="admin-panel recent-panel"><div class="panel-heading"><h2>Recent bookings</h2><a asp-page="/Admin/Reservations" class="table-link">View all bookings →</a></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Booking</th><th>Customer</th><th>Vehicle</th><th>Pickup</th><th>Return</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var row in Model.RecentBookings) { <tr><td>AD-@row.Rental.RentalID.ToString("D6")</td><td>@row.Customer</td><td><div class="table-vehicle"><span class="table-thumb photo-@row.ImageSlot"></span>@row.Car</div></td><td>@row.Rental.PickupDate.ToString("MMM d")</td><td>@row.Rental.PlannedReturnDate.ToString("MMM d")</td><td><span class="status-chip status-@row.Rental.Status.ToLowerInvariant()">@row.Rental.Status</span></td><td><a class="table-link" asp-page="/Admin/Reservations" asp-route-selectedId="@row.Rental.RentalID">View</a></td></tr> }
    </tbody></table></div>@if (Model.RecentBookings.Count == 0) { <p class="muted">No bookings yet. Create one from the catalog or Bookings page.</p> }</section>
    <div class="dashboard-side">
        <section class="admin-panel quick-actions"><h2>Quick actions</h2><div><a asp-page="/Admin/Cars" class="button button-ghost">Add vehicle</a><a asp-page="/Admin/Bookings" class="button button-ghost">Create booking</a><a asp-page="/Admin/Customers" class="button button-ghost">Add customer</a><a asp-page="/Admin/Payments" class="button button-ghost">Payments</a></div></section>
        <section class="admin-panel upcoming-panel"><div class="panel-heading"><h2>Upcoming returns</h2><a asp-page="/Admin/Reservations" asp-route-status="Active" class="table-link">View all →</a></div>@foreach (var row in Model.UpcomingReturns) { <a asp-page="/Admin/Reservations" asp-route-selectedId="@row.Rental.RentalID" class="upcoming-row"><span class="table-thumb photo-@row.ImageSlot"></span><span><strong>@row.Car</strong><small>AD-@row.Rental.RentalID.ToString("D6") · @row.Rental.PlannedReturnDate.ToString("MMM d")</small></span><b>→</b></a> }@if (Model.UpcomingReturns.Count == 0) { <p class="muted">No active rentals.</p> }</section>
    </div>
</div>
<div class="dashboard-lower game-lower"><section class="admin-panel level-panel"><h2>AUTODOK progress</h2><div class="level-display"><strong>LEVEL @Model.Level</strong><span>@Model.XP XP</span></div><div class="progress-track" role="progressbar" aria-valuenow="@Model.Progress" aria-valuemin="0" aria-valuemax="100"><span style="width:@Model.Progress%"></span></div><p class="muted">Earn XP by adding vehicles and customers, booking, and returning cars.</p></section><section class="admin-panel missions-panel"><h2>Missions</h2><div class="mission"><div><strong>Rental rookie</strong><span>Complete 1 rental · +50 XP</span></div><b>@Math.Min(1, Model.RentalCount)/1 @(Model.RentalMission ? "✓" : "")</b></div><div class="mission"><div><strong>Fleet builder</strong><span>Add 5 vehicles · +50 XP</span></div><b>@Math.Min(5, Model.AddedCars)/5 @(Model.FleetMission ? "✓" : "")</b></div><div class="mission"><div><strong>Customer service</strong><span>Add 3 customers · +50 XP</span></div><b>@Math.Min(3, Model.AddedCustomers)/3 @(Model.CustomerMission ? "✓" : "")</b></div></section></div>
