@page "{id:int}"
@model AUTODOK.Pages.Cars.DetailsModel
@{
    ViewData["Title"] = Model.Car.DisplayName;
}
<section class="shell detail-page">
    <a class="back-link" asp-page="/Index">← Back to vehicles</a>
    <div class="detail-grid">
        <div class="detail-photo photo-@Model.Car.ImageSlot" style="@Model.Car.PhotoStyle" role="img" aria-label="@Model.Car.DisplayName vehicle photo"></div>
        <div class="detail-info">
            <span class="availability @(Model.Car.Status == "Available" ? "is-available" : "is-rented")">@Model.Car.Status</span>
            <h1>@Model.Car.DisplayName</h1>
            <p class="detail-summary">@Model.Car.Description</p>
            <div class="spec-list">
                <div><span>Category</span><strong>@Model.Car.Category</strong></div>
                <div><span>Transmission</span><strong>@Model.Car.Transmission</strong></div>
                <div><span>Seats</span><strong>@Model.Car.Seats</strong></div>
                <div><span>Model year</span><strong>@Model.Car.Year</strong></div>
            </div>
            <div class="detail-booking">
                <div class="price price-large"><strong>₱@Model.Car.PricePerDay.ToString("N0")</strong><span>/ Day</span></div>
                @if (Model.Car.Status == "Available")
                {
                    <a class="button button-orange" asp-page="/Bookings/Create" asp-route-carId="@Model.Car.CarID">Rent this car <span aria-hidden="true">→</span></a>
                }
                else
                {
                    <span class="muted">This vehicle is currently unavailable. Explore another car.</span>
                }
            </div>
        </div>
    </div>
</section>
